// ═══════════════════════════════════════════════════════════════════
// §1 · GENERATOR & DATASOURCE
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════
// §2 · CORE MODELS
// ═══════════════════════════════════════════════════════════════════

model User {
  id          String  @id @default(uuid())
  clerkUserId String  @unique
  email       String  @unique
  name        String?
  imageUrl    String?

  // original relations
  transactions Transaction[]
  accounts     Account[]
  budgets      Budget[]

  // new model back-relations
  profile         UserProfile?
  savingsGoals    SavingsGoal[]
  categoryBudgets CategoryBudget[]
  tags            Tag[]
  notifications   Notification[]
  aiInsights      AiInsight[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0)
  isDefault Boolean     @default(false)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  savingsGoals SavingsGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  description       String?
  date              DateTime
  category          String
  receiptUrl        String?
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus  @default(COMPLETED)

  // ── M-Pesa bulk-import fields ──────────────────────────────────
  receiptNo         String?            // e.g. "OKL1234567" — used for deduplication
  source            String?            // e.g. "MPESA_IMPORT" | "MANUAL"
  // ──────────────────────────────────────────────────────────────

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tags        TransactionTag[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([receiptNo])
  @@map("transactions")
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal
  lastAlertSent DateTime?
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budgets")
}

// ═══════════════════════════════════════════════════════════════════
// §3 · ORIGINAL ENUMS
// ═══════════════════════════════════════════════════════════════════

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ═══════════════════════════════════════════════════════════════════
// §4 · NEW ENUMS
// ═══════════════════════════════════════════════════════════════════

enum Currency {
  KES
  USD
  EUR
  GBP
  UGX
  TZS
  RWF
  ETB
  ZAR
  NGN
  GHS
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum BudgetType {
  CATEGORY
  TOTAL
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  OTHER
}

// ═══════════════════════════════════════════════════════════════════
// §5 · NEW MODELS
// ═══════════════════════════════════════════════════════════════════

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredCurrency   Currency  @default(KES)
  phone               String?
  timezone            String    @default("Africa/Nairobi")
  country             String    @default("KE")
  mpesaNumber         String?
  webhookToken        String?   @unique
  monthlyIncomeTarget Decimal?
  onboardingCompleted Boolean   @default(false)
  lastActiveAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model SavingsGoal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  targetAmount Decimal
  savedAmount  Decimal    @default(0)
  currency     Currency   @default(KES)
  deadline     DateTime?
  priority     Priority   @default(MEDIUM)
  status       GoalStatus @default(ACTIVE)
  icon         String?
  color        String?

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  contributions GoalContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("savings_goals")
}

model GoalContribution {
  id     String      @id @default(uuid())
  goalId String
  goal   SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  amount Decimal
  note   String?
  date   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([goalId])
  @@map("goal_contributions")
}

model CategoryBudget {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category      String
  amount        Decimal
  type          BudgetType @default(CATEGORY)
  alertAt       Int        @default(80)
  lastAlertSent DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@map("category_budgets")
}

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?
  icon  String?

  transactions TransactionTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model Attachment {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  fileName  String
  fileUrl   String
  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@map("attachments")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String
  channel  NotificationChannel @default(IN_APP)
  isRead   Boolean             @default(false)
  sentAt   DateTime?
  readAt   DateTime?
  linkType String?
  linkId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AiInsight {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month    Int
  year     Int
  insights String[]
  score    Int?
  raw      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@map("ai_insights")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal
  fetchedAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, fetchedAt])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model AuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}